generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  password  String
  username  String    @unique
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String    @unique
  isSuperuser Boolean @map("is_superuser")
  isStaff   Boolean   @map("is_staff")
  isActive  Boolean   @map("is_active")
  dateJoined DateTime @map("date_joined")
  posts     BlogPost[]
  events    ClubEvent[]
  profile   MemberProfile?
  materials BuildMaterial[]
  assets    LibraryAsset[]
  astra     AstraProfile?

  @@map("auth_user")
}

model MemberProfile {
  id       BigInt    @id @default(autoincrement())
  isBanned Boolean   @map("is_banned")
  bannedAt DateTime? @map("banned_at")
  userId   Int       @unique @map("user_id")
  user     User      @relation(fields: [userId], references: [id])

  @@map("core_memberprofile")
}

model BuildMaterial {
  id               BigInt   @id @default(autoincrement())
  materialType     String   @map("material_type")
  name             String
  summary          String
  usedFor          String   @map("used_for")
  access           String
  urlName          String   @map("url_name")
  dashboardSection String   @map("dashboard_section")
  accessLabel      String   @map("access_label")
  purchaseUrl      String   @map("purchase_url")
  published        Boolean
  sortOrder        Int      @map("sort_order")
  authorId         Int?     @map("author_id")
  author           User?    @relation(fields: [authorId], references: [id])
  createdAt        DateTime @map("created_at")
  updatedAt        DateTime @map("updated_at")

  @@map("core_buildmaterial")
}

model LibraryFolder {
  id        BigInt         @id @default(autoincrement())
  name      String         @unique
  sortOrder Int            @map("sort_order")
  createdAt DateTime       @map("created_at")
  assets    LibraryAsset[]

  @@map("core_libraryfolder")
}

model LibraryAsset {
  id            BigInt         @id @default(autoincrement())
  title         String
  kind          String
  description   String
  image         String?
  referenceFile String?        @map("reference_file")
  sourcePath    String         @map("source_path")
  published     Boolean
  folderId      BigInt?        @map("folder_id")
  folder        LibraryFolder? @relation(fields: [folderId], references: [id])
  authorId      Int?           @map("author_id")
  author        User?          @relation(fields: [authorId], references: [id])
  createdAt     DateTime       @map("created_at")
  updatedAt     DateTime       @map("updated_at")

  @@map("core_libraryasset")
}

model BlogPost {
  id            BigInt   @id @default(autoincrement())
  title         String
  slug          String   @unique
  excerpt       String
  content       String
  featuredImage String?  @map("featured_image")
  published     Boolean
  authorId      Int      @map("author_id")
  author        User     @relation(fields: [authorId], references: [id])
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")

  @@map("core_blogpost")
}

model ClubEvent {
  id          BigInt    @id @default(autoincrement())
  title       String
  slug        String    @unique
  dateLabel   String    @map("date_label")
  summary     String
  description String
  location    String
  startsAt    DateTime? @map("starts_at")
  image       String?
  published   Boolean
  eventType   String    @default("Outreach") @map("event_type")
  authorId    Int?      @map("author_id")
  author      User?     @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")
  photos      EventPhoto[]

  @@map("core_clubevent")
}

model TelemetryFrame {
  id                BigInt   @id @default(autoincrement())
  receivedAt        DateTime @map("received_at")
  groundStation     String   @map("ground_station")
  packetKind        String   @map("packet_kind")
  sequenceNumber    Int?     @map("sequence_number")
  rocketTimeMs      BigInt?  @map("rocket_time_ms")
  altitudeM         Float?   @map("altitude_m")
  velocityMps       Float?   @map("velocity_mps")
  accelerationMps2  Float?   @map("acceleration_mps2")
  latitude          Float?
  longitude         Float?
  batteryV          Float?   @map("battery_v")
  temperatureC      Float?   @map("temperature_c")
  pressurePa        Float?   @map("pressure_pa")
  rssiDbm           Float?   @map("rssi_dbm")
  raw               Json
  createdAt         DateTime @map("created_at")
  flightSessionId   BigInt?  @map("flight_session_id")

  @@map("telemetry_telemetryframe")
}

// ── Oct 2026: job board, applications, editable site text ──

model JobRole {
  id           Int              @id @default(autoincrement())
  title        String
  subteam      String           @default("")
  summary      String           @default("")
  duties       String           @default("") // one per line
  requirements String           @default("") // one per line
  commitment   String           @default("")
  status       String           @default("draft") // draft | open | closed
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  applications JobApplication[]

  @@map("astra_job_role")
}

model JobApplication {
  id         Int      @id @default(autoincrement())
  roleId     Int      @map("role_id")
  role       JobRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  name       String
  email      String
  program    String   @default("")
  year       String   @default("")
  message    String   @default("")
  links      String   @default("")
  resumeName String   @map("resume_name")
  resumeType String   @map("resume_type")
  resumeSize Int      @map("resume_size")
  resume     Bytes // private: only served to staff via /dashboard/applications/[id]/resume
  status     String   @default("new") // new | reviewing | interview | accepted | declined
  notes      String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([roleId])
  @@map("astra_job_application")
}

model SiteText {
  key       String   @id
  value     String
  updatedBy String   @default("") @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("astra_site_text")
}

// Oct 2026 round 2: member profiles, event photos, page switches.

model AstraProfile {
  userId      Int      @id @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program     String   @default("")
  bio         String   @default("")
  linkedin    String   @default("")
  portfolio   String   @default("")
  wantSubteam String   @default("") @map("want_subteam")
  teamGroup   String   @default("") @map("team_group")
  teamTitle   String   @default("") @map("team_title")
  showOnTeam  Boolean  @default(true) @map("show_on_team")
  sortOrder   Int      @default(0) @map("sort_order")
  photo       Bytes?
  photoType   String   @default("") @map("photo_type")
  photoAt     DateTime? @map("photo_at")
  resume      Bytes? // private: only staff, and the member themself
  resumeName  String   @default("") @map("resume_name")
  resumeType  String   @default("") @map("resume_type")
  resumeSize  Int      @default(0) @map("resume_size")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("astra_profile")
}

model EventPhoto {
  id        Int       @id @default(autoincrement())
  eventId   BigInt    @map("event_id")
  event     ClubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  data      Bytes
  type      String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([eventId])
  @@map("astra_event_photo")
}

model SitePage {
  key       String   @id
  live      Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("astra_site_page")
}

// Oct 2026 security pass: shared rate limits (work across serverless instances) and an admin audit log.

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("astra_rate_limit")
}

model AuditLog {
  id     Int      @id @default(autoincrement())
  actor  String
  action String
  target String   @default("")
  at     DateTime @default(now())

  @@index([at])
  @@map("astra_audit")
}
