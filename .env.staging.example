# Staging environment template
# Copy values into Vercel → Project → Settings → Environment Variables
# for the Preview (or a dedicated Staging) environment — not Production.

NEXT_PUBLIC_SITE_URL=https://dev.alsp.ca

# Prefer a separate Neon database/branch from production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Different from production so staging sessions cannot reuse prod cookies.
AUTH_SECRET=generate-with-openssl-rand-base64-48

# Optional — leave blank to refuse private uploads on staging.
# S3_BUCKET=
# AWS_REGION=ca-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional overrides
# ADMIN_EMAILS=
# NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/zazwB3bx2N
# TELEMETRY_INGEST_TOKEN=
